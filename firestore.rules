rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed() { return request.auth != null; }
  function member(pid) { return signed() && request.auth.uid in get(/databases/$(database)/documents/projects/$(pid)).data.members; }
  match /projects/{pid} {
   allow read: if signed() && request.auth.uid in resource.data.members;
   allow create: if signed() && request.resource.data.owner == request.auth.uid
     && request.resource.data.members == [request.auth.uid]
     && request.resource.data.name is string && request.resource.data.name.size() > 0
     && request.resource.data.name.size() <= 60 && request.resource.data.inviteCode == '';
   allow update: if signed() && (
     (resource.data.owner == request.auth.uid
       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','inviteCode']))
     || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members','joinCode'])
       && request.resource.data.members is list
       && request.resource.data.members.toSet() == resource.data.members.toSet().union([request.auth.uid].toSet())
       && request.resource.data.members.size() <= 100
       && request.resource.data.joinCode == resource.data.inviteCode
       && get(/databases/$(database)/documents/invites/$(request.resource.data.joinCode)).data.projectId == pid));
   match /nodes/{nodeId} {
    allow read, delete: if member(pid);
    allow create, update: if member(pid)
      && request.resource.data.keys().hasOnly(['name','memo','tags','color','size','x','y','updatedAt'])
      && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
      && request.resource.data.memo is string && request.resource.data.memo.size() <= 20000
      && request.resource.data.tags is list && request.resource.data.tags.size() <= 20
      && request.resource.data.color is string && request.resource.data.color.matches('^#[0-9a-fA-F]{6}$')
      && request.resource.data.size is number && request.resource.data.size >= 90 && request.resource.data.size <= 250
      && request.resource.data.x is number && request.resource.data.y is number
      && request.resource.data.x >= -100000 && request.resource.data.x <= 100000
      && request.resource.data.y >= -100000 && request.resource.data.y <= 100000
      && request.resource.data.updatedAt == request.time;
   }
  }
  match /invites/{code} {
   allow get: if signed();
   allow list: if false;
   allow create: if signed() && request.resource.data.keys().hasOnly(['projectId','owner'])
     && request.resource.data.owner == request.auth.uid
     && get(/databases/$(database)/documents/projects/$(request.resource.data.projectId)).data.owner == request.auth.uid
     && getAfter(/databases/$(database)/documents/projects/$(request.resource.data.projectId)).data.inviteCode == code;
   allow delete: if signed() && resource.data.owner == request.auth.uid;
  }
 }
}
